# Sequential
NUM_ACCOUNTS=1
SEQUENTIAL_MODE=true
BREAK_BETWEEN_ACCOUNTS=30

# Proxy
USE_PROXY=false
PROXY_CONFIG_PATH=config/proxies.yaml

# Session duration
SESSION_DURATION_MINUTES=5

# Watch time
MIN_WATCH_TIME=5
MAX_WATCH_TIME=25

# Interaction rates
LIKE_RATE=0.3
FOLLOW_RATE=0.00
SHARE_RATE=0.02
COMMENT_RATE=0.01

# Scroll
SCROLL_MIN=1000
SCROLL_MAX=1400
SCROLL_BACK_RATE=0.08
SKIP_RATE=0.12
REWATCH_RATE=0.10

# Limits
MAX_LIKES_PER_HOUR=40
MAX_FOLLOWS_PER_DAY=30
MAX_ACTIONS_PER_MINUTE=12

# Debug
VERBOSE_LOG=true

# Cross-follow
OPEN_COMMENTS_RATE=0.8
MAX_COMMENTS_TO_SCAN=25
AUTO_REPLY_TO_CROSS_FOLLOW=true
AUTO_FOLLOW_CROSS_FOLLOW=true
MAX_COMMENT_SCROLLS=30

SCROLL_MODE=arrow
SCROLL_DISTANCE_MIN=1000
SCROLL_DISTANCE_MAX=1400

KEEP_COMMENTS_OPEN=true   # true: không đóng, false: đóng sau khi xử lý
COMMENT_ALREADY_OPEN=true # đã mở sẵn comment chưa

AUTO_REPLY_TO_CROSS_FOLLOW=false